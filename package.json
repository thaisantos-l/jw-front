{
  "name": "jw-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint src scripts --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src scripts *.json *.mjs",
    "format:check": "prettier --check src scripts *.json *.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "verify:export": "node scripts/verify-export.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "sass": "1.108.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2"
  }
}
